{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译 Griffith C++ 程序",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "编译并验证 Griffith",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$gcc"
    }
  ]
}
